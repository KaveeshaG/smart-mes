# Copy to .env.cloud on the cloud VM. Never commit .env.cloud itself.

DATABASE_URL=postgresql+asyncpg://user:password@host/smart-mes?ssl=require

# Must match the value set in .env.edge
RABBITMQ_PASSWORD=change-me

ANTHROPIC_API_KEY=sk-ant-...

# The edge node's Tailscale MagicDNS name, e.g. edge-box.your-tailnet.ts.net
EDGE_HOST=edge-box.your-tailnet.ts.net

# Leave unset to skip domain-based TLS and use `tailscale funnel` instead
# (see DEPLOYMENT.md). Only set this if you have a domain pointed at the VM.
PUBLIC_DOMAIN=
