# Single public entry point for the cloud VM. Browsers only ever talk to
# this — device-management and data-collector (on the edge node) are never
# exposed directly to the internet, only reached from here over Tailscale.
#
# Two ways to serve this, see DEPLOYMENT.md:
#   A) No domain (recommended to start, $0): leave PUBLIC_DOMAIN unset,
#      run this over plain HTTP internally, and let `tailscale funnel`
#      handle the public HTTPS certificate for you.
#   B) You own/have a free domain (e.g. DuckDNS): set PUBLIC_DOMAIN and
#      Caddy gets a real Let's Encrypt certificate automatically.

{$PUBLIC_DOMAIN:http://:80} {
	# Dashboard
	handle /* {
		reverse_proxy frontend:3000
	}

	# Cloud-local services — same-host container names
	handle_path /api/ai-agent/* {
		reverse_proxy ai-agent:8004
	}
	handle_path /api/production/* {
		reverse_proxy production:8002
	}

	# Edge services — reached over the private Tailscale mesh, never public
	# on their own. {$EDGE_HOST} is the edge node's Tailscale MagicDNS name.
	handle_path /api/device-mgmt/* {
		reverse_proxy {$EDGE_HOST}:8001
	}
	handle_path /api/data-collector/* {
		reverse_proxy {$EDGE_HOST}:8003
	}
}
