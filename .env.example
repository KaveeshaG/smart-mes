# Copy to .env and fill in real values. Never commit .env itself.

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Network Discovery
SCAN_TIMEOUT=2
PORT_SCAN_TIMEOUT=3
MAX_CONCURRENT_SCANS=50

# Modbus
MODBUS_PORT=502
MODBUS_TIMEOUT=3.0

# Logging
LOG_LEVEL=INFO

# AI Agent Service
# provider = anthropic | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=4.0

# Ollama (local, used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15.0

ZSCORE_WINDOW=100
ZSCORE_THRESHOLD=3.0
MIN_READINGS_FOR_BASELINE=10
POLL_INTERVAL_SECONDS=5.0
MAX_CONCURRENT_ANOMALY_HANDLERS=10
