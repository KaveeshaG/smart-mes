# Copy to .env.edge on the edge node (the machine on the same LAN as the PLCs).
# Never commit .env.edge itself.

# Neon Postgres — shared with the cloud side, already cloud-hosted
DATABASE_URL=postgresql+asyncpg://user:password@host/smart-mes?ssl=require

# Must match the value set in .env.cloud
RABBITMQ_PASSWORD=change-me
TIMESCALE_PASSWORD=change-me

# The cloud VM's Tailscale MagicDNS name, e.g. cloud-vm.your-tailnet.ts.net
CLOUD_HOST=cloud-vm.your-tailnet.ts.net
